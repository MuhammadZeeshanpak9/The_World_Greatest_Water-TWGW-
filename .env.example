# Supabase — required for the admin dashboard (/admin/*) and its API routes.
# Get these from Supabase Dashboard → Settings → API.
# NEVER commit real values here — this file only holds placeholders.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key bypasses Row Level Security entirely. Server-side only —
# never reference it from a client component. Treat it like a root password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — only affects metadata generation (canonical URLs, OpenGraph tags,
# sitemap.xml). Falls back to a sensible default if unset.
NEXT_PUBLIC_SITE_URL=https://theworldsgreatestwater.com

# Resend — required for transactional email (welcome, order confirmation, password
# reset, waitlist confirmation, admin form notifications). Get an API key from
# resend.com/api-keys. FROM must be a domain verified in Resend, or the sandbox
# address onboarding@resend.dev while your domain verification is pending.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_REPLY_TO=your-reply-to@yourdomain.com

# Shared secret required in the `x-revalidate-secret` header to call
# /api/revalidate. Pick any long random string — used by the admin dashboard to
# tell the public site to refresh cached product/blog pages after an edit.
REVALIDATE_SECRET=your-revalidate-secret

# Comma-separated allow-list of emails permitted to access /admin/* and
# /api/admin/*. Now that public customer registration exists, "is this user
# logged in" is no longer enough to grant admin access — this is checked
# explicitly on every admin request.
ADMIN_EMAILS=admin@yourdomain.com

# Reminder: once your sending domain is verified in Resend, add the SPF, DKIM,
# and DMARC DNS records Resend gives you (Dashboard → Domains → DNS Records)
# in your domain registrar (e.g. GoDaddy). Without these records, email sent
# from your own domain will land in spam regardless of how correct the code
# is — this is a DNS-level trust signal, not something the app can fix.

# Analytics — GA4 / Meta Pixel / TikTok Pixel. Leave as "PLACEHOLDER" (or
# "G-PLACEHOLDER" for GA4) to keep analytics fully disabled — the app treats
# a placeholder ID the same as "not configured" and never loads the script.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-PLACEHOLDER
NEXT_PUBLIC_META_PIXEL_ID=PLACEHOLDER
NEXT_PUBLIC_TIKTOK_PIXEL_ID=PLACEHOLDER

# Cal.com — one booking link per wellness offering. Leave any of these
# containing "placeholder" to show a "booking coming soon" contact fallback
# instead of the live embed for that offering.
NEXT_PUBLIC_CALCOM_BODY_LINK=https://cal.com/your-team/body
NEXT_PUBLIC_CALCOM_MIND_LINK=https://cal.com/your-team/mind
NEXT_PUBLIC_CALCOM_SOUL_LINK=https://cal.com/your-team/soul
NEXT_PUBLIC_CALCOM_UNLOCK_LINK=https://cal.com/your-team/unlock

# Shared secret Cal.com signs its webhook payloads with (HMAC-SHA256, header
# x-cal-signature-256). Set the same value in Cal.com's webhook settings.
CALCOM_WEBHOOK_SECRET=your-calcom-webhook-secret

# Stripe — pending real credentials from the client. Leave every value below as its
# literal "*_placeholder" string to keep all Stripe code paths fully disabled (the app
# falls back to free course enrollment, waitlist-only subscriptions, and a "card payments
# coming soon" checkout tab). The publishable key MUST use the NEXT_PUBLIC_ prefix — it's
# read in the browser by Stripe.js. The secret key must never carry that prefix.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_WEEKLY_PRICE_ID=price_placeholder_weekly
STRIPE_MONTHLY_PRICE_ID=price_placeholder_monthly
STRIPE_COURSE_PRICE_ID=price_placeholder_course

# PayPal — pending real credentials. Leave as placeholders to keep the PayPal checkout
# tab showing "coming soon" instead of the real Buttons SDK.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=paypal_placeholder
PAYPAL_CLIENT_SECRET=paypal_secret_placeholder
PAYPAL_WEBHOOK_ID=paypal_webhook_placeholder

# Shippo — pending real credentials. Leave as placeholder to keep /api/shipping/rates
# returning mock USPS/FedEx rates instead of calling the real Shippo API — checkout still
# works end-to-end for testing without a real key.
SHIPPO_API_KEY=shippo_placeholder
# Shippo doesn't sign webhook payloads with an HMAC header (unlike Stripe/Coinbase/Cal.com) —
# register the webhook URL with this same secret as a ?secret= query param, verified with a
# constant-time comparison in the webhook route.
SHIPPO_WEBHOOK_SECRET=your-shippo-webhook-secret

# Coinbase Commerce — pending real credentials. Leave as placeholders to keep the crypto
# checkout tab showing "coming soon."
COINBASE_COMMERCE_API_KEY=coinbase_placeholder
COINBASE_COMMERCE_WEBHOOK_SECRET=coinbase_webhook_placeholder

# Sender address used to generate Shippo shipping labels. These are documentation-only
# defaults — the live runtime source of truth is the site_settings table (editable from
# /admin/settings), seeded with these same placeholder values by the M10 migration.
# Update the real business address in /admin/settings before launch.
SHIPPO_SENDER_NAME=Your Company Name
SHIPPO_SENDER_STREET=123 Your Street
SHIPPO_SENDER_CITY=Your City
SHIPPO_SENDER_STATE=CA
SHIPPO_SENDER_ZIP=90001
SHIPPO_SENDER_COUNTRY=US

# TWGC (The World's Greatest Coin) ERC-20 on Polygon — deferred to post-launch Phase 2,
# not part of M10. Uncomment and set once that phase begins.
# TWGC_CONTRACT_ADDRESS=pending

# ELEV8 V.A. chatbot (RAG backend) — server-only, never reference from a client component.
# Get an API key from platform.openai.com. Until this is set, /api/chat/message serves a
# friendly fallback reply (WhatsApp/email/contact page) instead of a real answer — it never
# fails with a 500, and scripts/seed-kb.ts + scripts/eval-va.ts both exit early with a clear
# message instead of making any OpenAI calls.
OPENAI_API_KEY=your-openai-api-key
# Embedding model used to vectorize knowledge-base chunks and user queries. Must stay in
# sync with the vector(1536) column width in supabase/migrations/20261004000000_va_rag_schema.sql
# — changing this to a model with a different output dimension requires a new migration.
VA_EMBEDDING_MODEL=text-embedding-3-small
# Chat completion model used to generate the V.A.'s replies.
VA_CHAT_MODEL=gpt-4o-mini
# Cosine-similarity cutoff passed to match_kb_chunks() — chunks scoring at or below this are
# treated as "no relevant match" (the bot falls back to "I don't know, here's how to reach the
# team" instead of answering). text-embedding-3-small similarity scores for a genuinely
# relevant match typically land in the 0.3-0.6 range, not 0.8+, so start low and raise it only
# if scripts/eval-va.ts shows the bot retrieving irrelevant chunks.
VA_MATCH_THRESHOLD=0.3
